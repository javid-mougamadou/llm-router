# LLM Router configuration
# Copy this file: cp .env.example .env

# -- Auth --
MASTER_KEY=sk-change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# -- UI --
UI_REFRESH_INTERVAL=30

# -- AWS --
AWS_REGION=eu-west-3
AWS_PROFILE=default

# -- Database --
LLM_ROUTER_DB=/data/llm_router.db
# DATABASE_URL=postgresql://user:pass@host:5432/llm_router

# -- Server --
LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=4000
LLM_ROUTER_WORKERS=1
MAX_CONCURRENT=20

# -- Models (JSON override, optional) --
# LLM_ROUTER_MODELS='{"my-model":{"bedrock_id":"us.anthropic.claude-...","input_price":3.0,"output_price":15.0}}'
